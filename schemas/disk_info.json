{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Disk metadata",
  "type": "object",
  "required": ["total_space", "used_space", "trash_size", "system_folders"],
  "properties": {
    "total_space": { "type": "integer" },
    "used_space": { "type": "integer" },
    "trash_size": { "type": "integer" },
    "system_folders": { "type": "object" }
  }
}
